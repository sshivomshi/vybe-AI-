PS3_DATA_DIR=data/device-a
PS3_CLOUD_DIR=data/cloud
# Set the same random token on all your devices and the sync service.
PS3_CLOUD_URL=http://127.0.0.1:8090
PS3_SYNC_TOKEN=replace-with-a-long-random-token
PS3_MODEL_CACHE=data/models
PS3_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PS3_LOCAL_MODEL_URL=http://127.0.0.1:8081/v1
PS3_LOCAL_MODEL=ps3-local
# Optional OpenAI-compatible cloud inference (backend only).
PS3_CLOUD_MODEL_URL=
PS3_CLOUD_MODEL=
PS3_CLOUD_API_KEY=
